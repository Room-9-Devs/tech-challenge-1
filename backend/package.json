{
  "name": "nestjs-clean-architecture-template",
  "version": "1.0.0",
  "description": "Template base com NestJS + TypeScript + Clean Architecture + PostgreSQL + Docker",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src test --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:generate:container": "npm run typeorm -- migration:generate -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:run:container": "npm run typeorm -- migration:run -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/typeorm/data-source.ts",
    "migration:revert:container": "npm run typeorm -- migration:revert -d src/infrastructure/database/typeorm/data-source.ts",
    "vehicles:backfill-owners": "ts-node -r tsconfig-paths/register src/infrastructure/database/scripts/backfill-vehicle-owners.ts",
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/run-seeds.ts",
    "seed:container": "ts-node -r tsconfig-paths/register src/infrastructure/database/seeds/run-seeds.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.15.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.23",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^7.1.3",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "multer": "^2.3.0",
    "body-parser": "^2.3.0",
    "lodash": "^4.17.21",
    "js-yaml": "^4.1.0"
  }
}
