# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=fiap

# Auth (obrigatorio)
# A aplicacao falha no boot se JWT_SECRET nao estiver definido.
# Gere um valor forte por ambiente, ex.: openssl rand -hex 32
JWT_SECRET=change-me-with-a-strong-random-value

# Optional Parallelum subscription token; leave blank to use the public quota.
FIPE_API_TOKEN=

# Email (Resend)
# Peça a chave ao autor do projeto ou use a que veio na entrega.
# Sem chave, a aplicação funciona normalmente, mas não envia e-mails.
RESEND_API_KEY=
EMAIL_FROM=Oficina Mecânica - Tech Challenge <nao-responda@notificacoes.juliocavalcanti.com.br>
