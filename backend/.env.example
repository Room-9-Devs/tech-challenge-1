# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password123
DATABASE_NAME=fiap

# Optional Parallelum subscription token; leave blank to use the public quota.
FIPE_API_TOKEN=

# Email (Resend)
# Peça a chave ao autor do projeto ou use a que veio na entrega.
# Sem chave, a aplicação funciona normalmente, mas não envia e-mails.
RESEND_API_KEY=
EMAIL_FROM='"Oficina Mecânica - Tech Challenge" <nao-responda@notificacoes.juliocavalcanti.com.br>'
# Opcional: envia todos os e-mails para este endereço em vez do cliente (ex.: avaliação do projeto).
# Aceita vários endereços separados por vírgula.
EMAIL_REDIRECT_TO=
